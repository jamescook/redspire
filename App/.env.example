# Copy to .env (gitignored) and fill in what you need. build.sh sources this
# automatically if present. All of these are optional -- build.sh falls back
# to auto-detection / interactive keychain profiles when unset.

# Explicit signing identity, if you have more than one "Developer ID
# Application" cert in your keychain (build.sh auto-detects when there's
# exactly one).
# CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Local notarization (see the comment block at the top of build.sh for how to
# create this with `xcrun notarytool store-credentials`).
# NOTARY_PROFILE="battlespire-notary"

# CI notarization via an App Store Connect API key -- no keychain needed.
# Create one at https://appstoreconnect.apple.com/access/api
# NOTARY_KEY_PATH="./AuthKey_XXXXXXXXXX.p8"
# NOTARY_KEY_ID="XXXXXXXXXX"
# NOTARY_ISSUER_ID="00000000-0000-0000-0000-000000000000"
